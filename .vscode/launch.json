{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "dwh-host (release)",
      "cargo": {
        "args": ["build", "--release", "-p", "dwh-host"],
        "filter": {
          "name": "dwh-host",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": {
        "RUST_BACKTRACE": "1",
        "DWH_EXTENSIONS_DIR": "${workspaceFolder}/extensions",
        "DWH_FIXTURES_DIR": "${workspaceFolder}/fixtures",
        "LD_LIBRARY_PATH": "${workspaceFolder}/target/release:${env:LD_LIBRARY_PATH}"
      }
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "dwh-preview (sample.csv)",
      "cargo": {
        "args": ["build", "--bin", "dwh-preview", "-p", "dwh-engine"],
        "filter": {
          "name": "dwh-preview",
          "kind": "bin"
        }
      },
      "args": [
        "${workspaceFolder}/fixtures/sample.csv",
        "amount > 1000"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "RUST_BACKTRACE": "1"
      }
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "dwh-preview (pick CSV)",
      "cargo": {
        "args": ["build", "--bin", "dwh-preview", "-p", "dwh-engine"],
        "filter": {
          "name": "dwh-preview",
          "kind": "bin"
        }
      },
      "args": ["${input:csvPath}", "${input:filterCondition}"],
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Vite FE only",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "npm: electron:dev",
      "command": "npm run electron:dev",
      "cwd": "${workspaceFolder}"
    }
  ],
  "inputs": [
    {
      "id": "csvPath",
      "type": "promptString",
      "description": "Absolute path to CSV",
      "default": "${workspaceFolder}/fixtures/sample.csv"
    },
    {
      "id": "filterCondition",
      "type": "promptString",
      "description": "Optional SQL WHERE condition (empty allowed)",
      "default": "amount > 1000"
    }
  ]
}
