{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ui:dev",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:\\s+http://localhost:1420"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "ui:build",
      "type": "npm",
      "script": "build",
      "problemMatcher": ["$tsc"],
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "cargo: test dwh-pipeline",
      "type": "shell",
      "command": "cargo test -p dwh-pipeline",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo: build dwh-engine",
      "type": "shell",
      "command": "cargo build -p dwh-engine",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "smoke: dwh-preview sample",
      "type": "shell",
      "command": "cargo run -p dwh-engine --bin dwh-preview -- ${workspaceFolder}/fixtures/sample.csv 'amount > 1000'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$rustc"]
    }
  ]
}
